    uuid id PK
    uuid encounter_id FK
    text amendment_text
  }
  encounter_room_visits {
    uuid id PK
    uuid encounter_id FK
    uuid room_id FK
    timestamptz entered_at
  }
  rooms {
    uuid id PK
    text name
    text kind
    uuid ward_id FK
  }
  admissions {
    uuid id PK
    uuid encounter_id FK
    uuid bed_id FK
    uuid ward_id FK
    text status
  }
  beds {
    uuid id PK
    uuid ward_id FK
    text bed_number
    text status
  }
  wards {
    uuid id PK
    text name
    numeric daily_rate
  }

---
title: AegisCare HMS — Core ER (FHIR/SHA modules)
---
erDiagram
  patients {
    uuid id PK
    text file_number
    text national_id
    text sha_member_number
    text cr_number
    text blood_group
  }
  encounters {
    uuid id PK
    uuid patient_id FK
    uuid current_room_id FK
    text status
    text sha_notification_number
    text sha_fund_type
  }
  encounter_diagnoses {
    uuid id PK
    uuid encounter_id FK
    text icd11_code
    text diagnosis_type
    int sequence
  }
  clinical_notes {
    uuid id PK
    uuid encounter_id FK
    uuid admission_id FK
    text note_type
  }

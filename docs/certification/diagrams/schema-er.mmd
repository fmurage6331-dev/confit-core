  prescriptions {
    uuid id PK
    uuid registration_id FK
    uuid stock_item_id FK
    text status
    uuid dispensed_by FK
  }
  stock_items {
    uuid id PK
    text name
    text nlmis_code
    numeric current_quantity
  }
